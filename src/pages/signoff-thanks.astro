---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="You are on the list – SignOff Mobile"
  description="Thanks for joining the SignOff Mobile waitlist."
  hideBanner={true}
  hideAiHelp={true}
  hideFooter={true}
>
  <article style="max-width:560px;margin:2rem auto;text-align:center">
    <h1>You are on the list</h1>
    <p style="font-size:1.1rem;color:#334155;margin:1rem 0 1.5rem">
      Thanks. We will email you when a spot opens for early access to SignOff Mobile.
    </p>
    <a href="/" style="color:#1d4ed8">Back to Ask Before You Book</a>
  </article>
</BaseLayout>
