---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const checklists = (await getCollection('checklists'))
  .filter(c => !c.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const popular = [
  { label: 'Pool leak detection vs. repair', href: '/find-then-fix/' },
  { label: 'Foundation inspection vs. repair', href: '/engineer-first/' },
  { label: 'Water heater replacement and permits', href: '/permit-pulled/' },
  { label: 'Sewer inspection vs. cleaning', href: '/see-then-line/' },
];

const waterRepos = [
  { name: 'Head or Line', url: 'https://github.com/usabandit33/head-or-line', desc: 'Austin irrigation: head vs line leak' },
  { name: 'Dry Then Demo', url: 'https://github.com/usabandit33/dry-then-demo', desc: 'Dallas water damage: dry-out vs demo' },
  { name: 'Salt or Free', url: 'https://github.com/usabandit33/salt-or-free', desc: 'Charlotte water softener options' },
  { name: 'Find Then Fix', url: 'https://github.com/usabandit33/find-then-fix', desc: 'Phoenix pool leak checklist' },
  { name: 'Permit Pulled', url: 'https://github.com/usabandit33/permit-pulled', desc: 'Denver water-heater permit checklist' },
  { name: 'Test Then File ATL', url: 'https://github.com/usabandit33/test-then-file-atl', desc: 'Atlanta backflow test and file' },
];
---
<BaseLayout 
  title="Ask Before You Book — Free Service Checklists for Homeowners"
  description="Free, practical checklists to help you compare quotes, understand repair options, and avoid unnecessary work. Customer never pays the directory."
  hideAiHelp={true}
>
  <section class="hero">
    <h1>Hire with confidence. Know what to ask first.</h1>
    <p class="hero-lead">
      Free, practical checklists to help you compare quotes, understand repair options, and avoid unnecessary work.
    </p>
    <p class="tagline">Customer never pays the directory.</p>
  </section>

  <section class="discovery" aria-label="Find a checklist">
    <div class="search-card">
      <label class="search-label" for="service-query">
        <span class="search-icon" aria-hidden="true">🔍</span>
        What service do you need?
      </label>
      <input
        id="service-query"
        class="search-input"
        type="search"
        name="service"
        placeholder="Search pool repair, plumbing, roofing, foundation repair…"
        autocomplete="off"
      />
    </div>

    <div class="search-card">
      <label class="search-label" for="location-query">
        <span class="search-icon" aria-hidden="true">📍</span>
        Where do you need service?
      </label>
      <input
        id="location-query"
        class="search-input"
        type="search"
        name="location"
        placeholder="Enter your city or ZIP code"
        autocomplete="off"
      />
    </div>

    <div class="popular-card">
      <h2 class="popular-heading">Popular homeowner checklists</h2>
      <ul class="popular-list">
        {popular.map(item => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <p class="discovery-note">Illustrative layout — type to filter the full list below.</p>
  </section>

  <section class="ai-help home-ai" aria-label="Ask an AI">
    <p>Need help with your question? Ask an AI:</p>
    <div class="ai-buttons">
      <a href="https://chat.openai.com/" target="_blank" rel="noopener" class="btn btn-chatgpt">ChatGPT</a>
      <a href="https://grok.x.ai/" target="_blank" rel="noopener" class="btn btn-grok">Grok</a>
      <a href="https://claude.ai/" target="_blank" rel="noopener" class="btn btn-claude">Claude</a>
    </div>
  </section>

  <section class="all-guides" id="all-guides">
    <h2>All guides</h2>
    <ul class="checklist-list" id="checklist-results">
      {checklists.map(c => (
        <li data-title={c.data.title.toLowerCase()} data-city={c.data.city.toLowerCase()} data-service={c.data.service.toLowerCase()}>
          <a href={`/${c.id}/`}>{c.data.title}</a>
          <br />
          <span class="meta">{c.data.city} · {c.data.service}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="water-section">
    <h2>Water-related research repos</h2>
    <p>Full research for selected water issues lives in these linked repos.</p>
    <ul class="checklist-list">
      {waterRepos.map(r => (
        <li>
          <a href={r.url} target="_blank" rel="noopener">{r.name}</a>
          <br />
          <span class="meta">{r.desc}</span>
        </li>
      ))}
    </ul>
    <p>Consider a <a href="https://amzn.to/4zzJZ85" rel="noopener" target="_blank">GoveeLife Water Leak Detector</a> for early alerts.</p>
  </section>

  <script is:inline>
    (function () {
      const serviceInput = document.getElementById('service-query');
      const locationInput = document.getElementById('location-query');
      const items = document.querySelectorAll('#checklist-results li');

      function filter() {
        const service = (serviceInput?.value || '').trim().toLowerCase();
        const location = (locationInput?.value || '').trim().toLowerCase();

        items.forEach((li) => {
          const title = li.getAttribute('data-title') || '';
          const city = li.getAttribute('data-city') || '';
          const svc = li.getAttribute('data-service') || '';
          const haystack = `${title} ${city} ${svc}`;

          const serviceOk = !service || haystack.includes(service);
          const locationOk = !location || city.includes(location) || haystack.includes(location);
          li.style.display = serviceOk && locationOk ? '' : 'none';
        });
      }

      serviceInput?.addEventListener('input', filter);
      locationInput?.addEventListener('input', filter);
    })();
  </script>
</BaseLayout>
