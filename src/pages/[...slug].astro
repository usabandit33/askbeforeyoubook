---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContractorSubmitForm from '../components/ContractorSubmitForm.astro';

export async function getStaticPaths() {
  const checklists = (await getCollection('checklists')).filter(c => !c.data.draft);

  return checklists.map(entry => {
    const sameCity = checklists
      .filter(c => c.data.city.toLowerCase() === entry.data.city.toLowerCase() && c.id !== entry.id)
      .slice(0, 4);

    const sameService = checklists
      .filter(c => c.data.service.toLowerCase() === entry.data.service.toLowerCase() && c.id !== entry.id)
      .slice(0, 4);

    // Fallback popular guides if few city/service matches
    const generalRelated = checklists
      .filter(c => c.id !== entry.id && !sameCity.some(sc => sc.id === c.id) && !sameService.some(ss => ss.id === c.id))
      .slice(0, 3);

    return {
      params: { slug: entry.id },
      props: {
        entry,
        sameCity,
        sameService,
        generalRelated,
      },
    };
  });
}

const { entry, sameCity, sameService, generalRelated } = Astro.props;
const { Content } = await render(entry);

const siteUrl = Astro.site ?? new URL('https://askbeforeyoubook.com');
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": entry.data.title,
    "description": entry.data.description,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": pageUrl
    },
    "dateModified": entry.data.lastReviewed ? `${entry.data.lastReviewed}T00:00:00Z` : "2026-10-16T00:00:00Z",
    "author": {
      "@type": "Organization",
      "name": "Ask Before You Book",
      "url": "https://askbeforeyoubook.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Ask Before You Book",
      "url": "https://askbeforeyoubook.com"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl.href
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": `${entry.data.city} Guides`,
        "item": `${siteUrl.href}#${entry.data.city.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": entry.data.title,
        "item": pageUrl
      }
    ]
  }
];
---
<BaseLayout 
  title={`${entry.data.title} | Ask Before You Book`} 
  description={entry.data.description}
  hideBanner={true}
  schema={schema}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><span aria-hidden="true">/</span> <a href="/#categories">{entry.data.city}</a></li>
      <li><span aria-hidden="true">/</span> <span class="current" aria-current="page">{entry.data.service}</span></li>
    </ol>
  </nav>

  <article class="checklist-article">
    <header class="article-header">
      <div class="badge-row">
        <span class="city-badge">📍 {entry.data.city}</span>
        <span class="service-badge">🛠️ {entry.data.service}</span>
        {entry.data.lastReviewed && (
          <span class="review-badge">Verified {entry.data.lastReviewed}</span>
        )}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="article-lead">{entry.data.description}</p>
    </header>

    <div class="content-body">
      <Content />
    </div>
  </article>

  <section class="related-section" aria-label="Related Checklists">
    <h2>Related Checklists & Comparison Guides</h2>
    
    {sameCity.length > 0 && (
      <div class="related-block">
        <h3>More Homeowner Guides for {entry.data.city}</h3>
        <ul class="related-list">
          {sameCity.map(item => (
            <li>
              <a href={`/${item.id}/`}>{item.data.title}</a>
              <span class="meta">{item.data.service}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {sameService.length > 0 && (
      <div class="related-block">
        <h3>{entry.data.service} Checklists in Other Cities</h3>
        <ul class="related-list">
          {sameService.map(item => (
            <li>
              <a href={`/${item.id}/`}>{item.data.title}</a>
              <span class="meta">{item.data.city}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {(!sameCity.length || !sameService.length) && generalRelated.length > 0 && (
      <div class="related-block">
        <h3>Popular Contractor Checklists</h3>
        <ul class="related-list">
          {generalRelated.map(item => (
            <li>
              <a href={`/${item.id}/`}>{item.data.title}</a>
              <span class="meta">{item.data.city} · {item.data.service}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <ContractorSubmitForm
    city={entry.data.city}
    service={entry.data.service}
    checklistTitle={entry.data.title}
  />
</BaseLayout>
