---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  hideAiHelp?: boolean;
  hideBanner?: boolean;
  hideFooter?: boolean;
}
const {
  title,
  description = "Free checklists for homeowners. Ask the right questions before you book or hire. Customer never pays the directory.",
  hideAiHelp = false,
  hideBanner = false,
  hideFooter = false,
} = Astro.props;
const canonical = Astro.url.href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="34980c25-3b9a-47df-8e13-524b0a3409cf"></script>
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/" class="logo">
          Ask Before You Book
        </a>
        <nav>
          <a href="/#all-guides">All guides</a>
          <a href="/ai-consulting/">AI Consulting</a>
        </nav>
      </div>
    </header>

    {!hideBanner && (
      <div class="banner">
        <img src="/banner.jpg" alt="Ask Before You Book - Free Service Checklists for Homeowners" />
      </div>
    )}

    {!hideAiHelp && (
      <div class="ai-help">
        <p>Need help with your question? Ask an AI:</p>
        <div class="ai-buttons">
          <a href="https://chat.openai.com/" target="_blank" rel="noopener" class="btn btn-chatgpt">ChatGPT</a>
          <a href="https://grok.x.ai/" target="_blank" rel="noopener" class="btn btn-grok">Grok</a>
          <a href="https://claude.ai/" target="_blank" rel="noopener" class="btn btn-claude">Claude</a>
        </div>
      </div>
    )}

    <main class="container">
      <slot />
    </main>

    {!hideFooter && (
      <footer class="container">
        <p><strong>Customer never pays the directory.</strong></p>
        <p>This site provides free general information only. It is not a recommendation, endorsement, ranking, or guarantee of any provider. Always verify details directly with the company before hiring.</p>
        <p>Protect your home with a <a href="https://amzn.to/4zzJZ85" rel="noopener" target="_blank">GoveeLife Water Leak Detector</a>.</p>
      </footer>
    )}
  </body>
</html>
